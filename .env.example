# CineMatch – Movie Recommendation System
# Advanced Database Management System (ADBMS) Mini-Project
# Environment Configuration Template

# 1. Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public API Key (found in Project Settings -> API)
# NEVER put your service_role secret key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note: If these keys are not set, CineMatch automatically runs in
# "Demo / Viva Mode" with the full 119-movie dataset and in-memory mock persistence.
